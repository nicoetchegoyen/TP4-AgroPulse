# Backend services. Copy to .env and replace every placeholder.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DEMO_PASSWORD=CHANGE_ME_BEFORE_USE

# Kafka endpoint used by containers in infra/docker-compose.yml.
KAFKA_BROKERS=redpanda-0:9092
KAFKA_CLIENT_ID=agropulse
KAFKA_GROUP_ID=agropulse-readings-worker
COMMAND_FAILURE_RATE=0.10

# Keep Monte A stale during the classroom demonstration.
SIMULATOR_STATION_IDS=30000000-0000-4000-8000-000000000001,30000000-0000-4000-8000-000000000002
